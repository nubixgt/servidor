# Servidor
PORT=3000
HOST=0.0.0.0
# DB_FILE=./data/cyd.db
# BACKUP_DIR=./backups
SESSION_HOURS=12

# Administrador inicial (se crea sólo si aún no existe ningún administrador;
# deberá cambiar la contraseña al ingresar). Use una contraseña larga; la app no impone formato.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administración Colegio CyD

# Subruta pública si la app no está en la raíz del dominio (ej. /cydplanicador). Vacío = raíz.
BASE_PATH=

# Producción detrás de HTTPS
SECURE_COOKIES=0
TRUST_PROXY=0

# Correo (opcional; sin esto la recuperación es administrativa)
# PUBLIC_URL incluye la subruta, ej. https://m.nubix.gt/cydplanicador
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
