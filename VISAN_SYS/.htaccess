# Sistema VISAN · protección de archivos internos
Options -Indexes
DirectoryIndex index.html

# Evita que el navegador se quede con una versión vieja del HTML o del JS
# después de un despliegue (obliga a revalidar con el servidor en cada carga).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Datos antiguos, Excel y archivos auxiliares no se sirven públicamente
<FilesMatch "(^data\.js|\.xlsx|\.sqlite.*|LEEME\.txt|\.DS_Store)$">
    Require all denied
</FilesMatch>

# Solo los endpoints del API son accesibles; los archivos de soporte PHP no
<Files "config.php">
    Require all denied
</Files>
<Files "bootstrap.php">
    Require all denied
</Files>
<Files "matriz_excel.php">
    Require all denied
</Files>
