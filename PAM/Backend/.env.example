# Copiar a .env y ajustar. Nunca subir .env al repositorio.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pam
DB_USER=root
DB_PASSWORD=

# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
ACCESS_TTL_MIN=30
REFRESH_TTL_H=12
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
BUSQUEDA_RPM=90

# desarrollo | produccion (en produccion se ocultan los detalles de los errores internos)
ENTORNO=desarrollo
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
# Origenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=600
# Archivos de hasta este tamano se procesan al subirlos; los mayores quedan PENDIENTES: php bin/importar.php --worker
IMPORT_INLINE_MB=30
