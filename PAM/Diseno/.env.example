# ======================== Sistema PAM · configuración ========================
# Copie este archivo como .env y cambie TODOS los valores marcados con CAMBIAR.

# Base de datos
POSTGRES_DB=pam
POSTGRES_USER=pam
POSTGRES_PASSWORD=CAMBIAR-clave-larga-de-base-de-datos
PG_SHARED_BUFFERS=2GB          # ~25 % de la RAM del servidor
PG_CACHE=6GB                   # ~75 % de la RAM del servidor

# Seguridad de la API (genere con:  openssl rand -hex 32)
JWT_SECRET=CAMBIAR-genere-64-caracteres-aleatorios
ACCESS_TTL_MIN=30              # minutos de vida del token de acceso
REFRESH_TTL_H=12               # horas de una sesión sin volver a ingresar
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
COOKIE_SECURE=true             # true en producción con HTTPS
ENTORNO=produccion             # 'desarrollo' habilita /api/docs
API_WORKERS=4                  # procesos de la API (≈ núcleos de CPU)
BUSQUEDA_RPM=90                # consultas de búsqueda por usuario por minuto
MAX_UPLOAD_MB=600

# Publicación
HTTP_PORT=80
HTTPS_PORT=443
TLS_DIR=./deploy/nginx/certs   # debe contener pam.crt y pam.key

# Respaldos automáticos (pg_dump diario)
BACKUP_DIR=./respaldos
RETENCION_DIAS=30
HORA_RESPALDO=01
