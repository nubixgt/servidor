# Copiar a .env y ajustar. Nunca subir .env al repositorio.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=testbases
DB_USER=root
DB_PASSWORD=

# Obligatorio, mínimo 32 caracteres. Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Vida del token de sesión, en minutos (480 = 8 horas)
ACCESS_TTL_MIN=480
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# desarrollo | produccion (en produccion se ocultan los detalles de los errores internos)
ENTORNO=desarrollo
# Origenes del frontend permitidos (separados por coma). En produccion el frontend y la API
# comparten dominio, asi que no hace falta.
CORS_ORIGINS=http://localhost:5173

# Tamano maximo de cada imagen adjunta. El limite real tambien depende de upload_max_filesize de PHP.
MAX_IMAGEN_MB=5
