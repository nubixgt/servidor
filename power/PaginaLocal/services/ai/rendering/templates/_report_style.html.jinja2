{#
  The shared design system for every report the athlete reads or prints.

  Plan Maestro v5 Track 9. Before this, the analysis report was HTML an LLM
  wrote from scratch on every single run, so the athlete got a differently-
  designed document every time and it cost a model call per generation to
  produce CSS. Every report includes this block and then adds ONLY its own
  layout rules: one palette, one type scale, one set of print rules.

  2026-09-11: "los planes en PDF aun no son dignos de la refri del atleta, son
  blancos y aburridos". The sheets had the right content in a generic office
  look -- grey rules on white, Helvetica, no identity. They now carry the app's
  own brand onto paper: Inter + JetBrains Mono (the fonts of the app), a
  masthead in the brand's olive-black with its lime, and ONE colour per sport
  so a session is recognisable across the kitchen. The ground stays white: it
  is going to be printed at home, and a dark page is a cartridge.
#}
  :root {
    --ink: #14161b;
    --ink-soft: #545a66;
    --ink-faint: #8a909c;
    --rule: #dde0e6;
    --rule-strong: #a3a9b4;
    --band: #f5f6f1;
    /* The brand. --brand is the lime of the app; on white it is a FILL, never
       text (it fails contrast). --accent is its readable dark twin. */
    --brand: #caf300;
    --brand-ink: #121700;
    --accent: #4f6b00;
    --deload: #c2560c;
    --good: #1a7f4b;
    --warn: #c2560c;
    --bad: #b3261e;
    /* One colour per sport, chosen to stay apart in print and in greyscale. */
    --run: #e8590c;
    --bike: #1c7ed6;
    --swim: #0ca678;
    --strength: #7048e8;
    --other: #868e96;
    --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  * { box-sizing: border-box; }
  /* Backgrounds are part of the design (masthead, sport bars): ask the
     browser to print them instead of dropping them to save ink. */
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

  body {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #fff;
    margin: 0;
    line-height: 1.45;
    font-feature-settings: "cv11", "ss01";
  }
  .num, .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }

  /* The masthead every sheet opens with: the brand, what this is, for whom. */
  .masthead {
    background: var(--brand-ink); color: #f1f3e8;
    border-radius: 10px; padding: 12px 16px;
    display: flex; justify-content: space-between; align-items: flex-end; gap: 16px;
    margin-bottom: 12px; position: relative; overflow: hidden;
  }
  .masthead::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--brand);
  }
  .masthead .brand {
    font-size: 7.5pt; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--brand);
  }
  .masthead h1 {
    font-size: 20pt; font-weight: 900; margin: 2px 0 0; letter-spacing: -.02em; line-height: 1.05;
    text-wrap: balance;
  }
  .masthead .who { font-size: 9pt; color: #c9cdbd; margin-top: 3px; }
  .masthead .facts { display: flex; gap: 16px; text-align: right; }
  .masthead .fact .v { font-family: var(--mono); font-size: 15pt; font-weight: 700; color: #fff; line-height: 1; }
  .masthead .fact .l {
    font-size: 6.5pt; text-transform: uppercase; letter-spacing: .1em; color: #a9ae9a; margin-top: 3px;
  }

  .sheet-footer {
    margin-top: 12px; padding-top: 5px; border-top: 1px solid var(--rule);
    font-size: 7pt; color: var(--ink-faint);
    display: flex; justify-content: space-between; gap: 12px;
  }

  /* Section label: small, spaced, with the brand's lime tick in front. */
  .section-label, h2.section {
    font-size: 8pt; text-transform: uppercase; letter-spacing: .1em;
    color: var(--ink); margin: 16px 0 7px; font-weight: 800;
    display: flex; align-items: center; gap: 7px;
  }
  .section-label::before, h2.section::before {
    content: ""; width: 10px; height: 10px; border-radius: 2px; background: var(--brand);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .12);
  }

  .callout {
    border: 1px solid var(--rule); border-left: 4px solid var(--brand);
    border-radius: 6px; padding: 8px 11px; margin: 8px 0;
    background: var(--band); font-size: 9pt;
  }
  .callout.warn { border-left-color: var(--warn); }
  .callout.bad { border-left-color: var(--bad); }

  .stat-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; }
  .stat {
    flex: 1 1 130px; border: 1px solid var(--rule); border-radius: 8px; padding: 7px 10px;
    border-top: 3px solid var(--brand);
  }
  .stat .label {
    font-size: 6.8pt; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft); font-weight: 700;
  }
  .stat .value { font-family: var(--mono); font-size: 14pt; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat .note { font-size: 7.5pt; color: var(--ink-soft); }

  /* Sport colours, applied by class so every sheet speaks the same code. */
  .s-run { --sport: var(--run); }
  .s-bike { --sport: var(--bike); }
  .s-swim { --sport: var(--swim); }
  .s-strength { --sport: var(--strength); }
  .s-other, .s-walk, .s-rest, .s-brick { --sport: var(--other); }

  /* Markdown rendered from an agent's own text. Constrained on purpose: an
     agent writing a 20pt heading into a printed report is not a design choice
     anyone made. */
  .prose { font-size: 9.3pt; line-height: 1.5; }
  .prose h1, .prose h2, .prose h3 {
    font-weight: 800; margin: 14px 0 5px; letter-spacing: -.005em; break-after: avoid;
  }
  .prose h1 { font-size: 12pt; padding-bottom: 3px; border-bottom: 2px solid var(--brand); }
  .prose h2 { font-size: 10.5pt; }
  .prose h2::before { content: "▍"; color: var(--accent); margin-right: 3px; }
  .prose h3 { font-size: 9.6pt; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; }
  .prose p { margin: 0 0 7px; }
  .prose ul, .prose ol { margin: 0 0 8px; padding-left: 16px; }
  .prose li { margin-bottom: 2px; }
  .prose li::marker { color: var(--accent); }
  .prose strong { color: var(--ink); font-weight: 700; }
  .prose code {
    font-family: var(--mono); font-size: 8.4pt; background: var(--band); padding: 0 3px; border-radius: 3px;
  }
  .prose blockquote {
    margin: 8px 0; padding: 5px 11px; border-left: 4px solid var(--brand);
    background: var(--band); border-radius: 0 6px 6px 0; color: var(--ink-soft);
  }
  .prose hr { border: 0; border-top: 1px solid var(--rule); margin: 12px 0; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 8.6pt; margin: 6px 0 10px; break-inside: avoid; }
  .prose th {
    text-align: left; font-size: 7pt; text-transform: uppercase; letter-spacing: .07em;
    color: var(--ink-soft); background: var(--band); border-bottom: 2px solid var(--ink); padding: 4px 6px;
  }
  .prose td { padding: 3px 6px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose img { max-width: 100%; }

  /* On screen the sheet sits on a desk; on paper it fills the page. */
  @media screen {
    body { background: #e7e9e1; padding: 16px; }
    .sheet {
      background: #fff; margin: 0 auto; padding: 22px 24px; border-radius: 6px;
      box-shadow: 0 2px 10px rgba(18, 23, 0, .16);
    }
    .print-bar { margin: 0 auto 12px; display: flex; gap: 10px; align-items: center; }
    .print-bar button {
      font: inherit; font-weight: 800; cursor: pointer; color: var(--brand-ink);
      background: var(--brand); border: 0; border-radius: 8px; padding: 8px 16px;
      text-transform: uppercase; letter-spacing: .05em; font-size: 9pt;
    }
    .print-bar span { color: var(--ink-soft); font-size: 9pt; }
  }

  @media print {
    .print-bar { display: none; }
    .sheet { box-shadow: none; padding: 0; }
  }
