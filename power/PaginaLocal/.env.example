# Environment variables for garmin-ai-coach (example only)
# Copy to .env or .env.dev and fill in real values. Do NOT commit real secrets.

# LLM providers — the model mapping per AI_MODE lives in services/ai/ai_settings.py
# (AISettings.model_assignments). Set whichever API keys that mapping actually needs:
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
# Optional LAST RESORT: routes a model through OpenRouter when its direct
# provider key is missing. Prefer the direct keys above -- OpenRouter adds its
# own margin on top of the provider's price AND drops provider-specific
# parameters (Anthropic adaptive thinking, OpenAI's Responses API), so the Pro
# tier quietly delivers less than it promises. Keys start with "sk-or-v1-";
# anything else is ignored at startup with a warning, because a key from the
# wrong provider in this slot fails deep inside a paid run instead of at boot.
# OPENROUTER_API_KEY=sk-or-v1-...

# Observability (optional)
LANGSMITH_API_KEY=lsv2_...

# App mode: development | cost_effective | standard | pro
# Only "standard" (UI label "Lite") and "pro" (UI label "Pro") are exposed in
# the web UI's ai_mode selector; development/cost_effective are internal-only
# testing aliases. Real mapping per role lives in services/ai/ai_settings.py:
#   development     -> Gemini 3.1 Flash-Lite everywhere   | requires GEMINI_API_KEY
#   cost_effective  -> same as development (internal alias, may diverge later)
#   standard/"Lite" -> Gemini 3.1 Flash-Lite (data-heavy roles) + Gemini 3.5 Flash (planner/synthesis)
#                      | requires GEMINI_API_KEY
#   pro/"Pro"       -> Claude Sonnet 5 (data-heavy roles), Claude Opus 5 (weekly planner),
#                      GPT-5.2 with web search (synthesis + season planner)
#                      | requires ANTHROPIC_API_KEY and OPENAI_API_KEY
#                      ⚠️  Pro costs several times more per run than Lite. The weekly planner
#                      makes four calls with large JSON output, so it dominates the bill —
#                      check the cost breakdown in the app after your first Pro run.
AI_MODE=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Seguridad (v7). Obligatorias en cuanto la app deje de ser de una sola persona.
# ─────────────────────────────────────────────────────────────────────────────

# Cifra la contraseña de Garmin de cada atleta en reposo, dentro de
# user_secure_data/profiles.json (core/credential_crypto.py).
#
# SIN ELLA LAS CONTRASEÑAS DE GARMIN SE GUARDAN EN TEXTO PLANO. Hasta v7 esta
# variable no estaba documentada aquí, así que una instalación nueva caía en
# ese comportamiento dejando sólo un WARNING en el log. Con atletas de verdad
# eso es inaceptable: son credenciales de un tercero, no datos de la app.
#
# Generar una (y guardarla: si se pierde, las contraseñas cifradas con ella no
# se pueden recuperar y cada atleta tendrá que volver a escribir la suya):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_CREDENTIALS_KEY=

# La cookie de sesión sale con el atributo Secure salvo que esto lo apague, o
# sea: SOLO viaja por HTTPS. Por omisión va cerrada, para que un despliegue
# que se olvide de configurarla quede seguro y no abierto.
#
# En localhost no hay HTTPS y el navegador descarta la cookie, así que nadie
# puede entrar: en desarrollo hay que ponerla en false. En el servidor, NO la
# toques -- déjala sin definir.
# COOKIE_SECURE=false

# Orígenes que pueden llamar a esta API con credenciales. Por omisión sólo los
# locales; en el servidor pon el dominio real, separado por comas.
# CORS_ALLOWED_ORIGINS=https://tudominio.com
