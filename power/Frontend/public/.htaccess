<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /power/

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA fallback: let Vue Router handle any path that isn't a real file/dir.
  # No toca /power/backend/ (la API PHP tiene su propio .htaccess).
  RewriteRule ^backend/ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /power/index.html [L]
</IfModule>
