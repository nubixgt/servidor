# Base URL for the Backend API. Copy this file to .env.local and adjust for your setup.
# In production this is set at build time by the GitHub Actions workflow.
VITE_API_BASE_URL=https://m.nubix.gt/power/backend/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Numero de WhatsApp del boton "Reportar" (abajo a la derecha).
# OPCIONAL: el componente ya trae el numero por defecto, asi que no hace falta
# configurar nada. Esto solo existe para cambiarlo sin tocar codigo.
# Solo digitos, con prefijo de pais y sin +, espacios ni guiones.
# VITE_FEEDBACK_WHATSAPP=50230965754
