# AiService reads its config from the REPO-ROOT .env (../.env), the same file
# PaginaLocal uses. You normally don't need a separate AiService/.env.
#
# Required in ../.env:
#   OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY  (per AI_MODE)
#   AI_MODE=standard        # lo que corre en PRODUCCION. Ponlo tambien en local:
#                           # probar en 'pro' es probar otros modelos. Medido el
#                           # 2026-09-10 en las trazas archivadas del atleta 2:
#                           #   standard -> resumidores gemini-3.1-flash-lite,
#                           #               expertos gpt-5.2, decision gpt-5.2,
#                           #               codificador claude-haiku-4.5
#                           #   pro      -> lo mismo, pero expertos claude-sonnet-5
#                           # NO es "solo Gemini" ni "el tier Lite": eso dejo de
#                           # ser verdad en v8 y se siguio repitiendo aqui.
#   GARMIN_CREDENTIALS_KEY  # Fernet key
#   BRIDGE_SERVICE_TOKEN    # shared secret; Backend/.env must use the same value as PYTHON_SERVICE_TOKEN
#
# Optional:
#   ENV_FILE=/abs/path/to/.env   # override which .env to load
#   LOG_LEVEL=INFO
#   AISERVICE_PORT=8600
#
# Cola de generaciones. Cada generacion es un proceso que corre la pipeline
# entera; las claves de API son unas solas para todos. Medido sobre runs
# reales: ~8 llamadas y ~112k tokens de entrada por semana generada, en
# rafagas de 3 llamadas simultaneas por proveedor. Este numero es cuantas
# pueden correr A LA VEZ; el resto espera en cola FIFO y el atleta ve su
# puesto. Subirlo sin margen en los limites de la API convierte una espera
# en una tanda de 429.
#   MAX_CONCURRENT_GENERATIONS=3
