<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /CONADEA/

    # 1a. Serve real files under Backend/ as-is (e.g. uploaded course
    # images in Backend/uploads/), instead of swallowing them into the API.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^Backend/(.*)$ - [L]

    # 1b. API Routing
    # Send requests starting with Backend/ to the API entry point
    RewriteRule ^Backend/(.*)$ Backend/api/v1/index.php [QSA,L]

    # 1c. Let requests to whatsapp-bot/ through untouched — that path is
    # served by the Node.js app (Passenger), not by this Apache vhost's
    # static/SPA rules below.
    RewriteRule ^whatsapp-bot/ - [L]

    # 2. Static Files (Frontend)
    # Check if the requested file exists in Frontend/dist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/CONADEA/Frontend/dist/$1 -f
    RewriteRule ^(.*)$ Frontend/dist/$1 [L]

    # 3. SPA Fallback
    # Route all other requests to Frontend/dist/index.html for Vue Router
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . Frontend/dist/index.html [L]

    # Handle the root path specifically
    RewriteRule ^$ Frontend/dist/index.html [L]
</IfModule>
